ANTHROPIC_API_KEY=
JWT_SECRET=replace-with-a-random-secret
# Use an absolute database path. Omit to use backend/tcp.db.
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/tcp.db
# Generate once using: python backend/provenance_keys.py /secure/tcp-keys
PROVENANCE_REGISTRY=/secure/tcp-keys/registry.json
PROVENANCE_LOGGER_KEY=/secure/tcp-keys/logger.pem
PROVENANCE_PROFILER_KEY=/secure/tcp-keys/profiler.pem
PROVENANCE_DETECTOR_KEY=/secure/tcp-keys/detector.pem
PROVENANCE_CLUSTERER_KEY=/secure/tcp-keys/clusterer.pem
